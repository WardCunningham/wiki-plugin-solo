    "type": "git",
    "url": "https://github.com/wardcunningham/wiki-plugin-solo.git"
  },
  "bugs": {
    "url": "https://github.com/wardcunningham/wiki-plugin-solo/issues"
  },
  "engines": {
    "node": ">=20.x"
  }
